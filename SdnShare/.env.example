# ═══════════════════════════════════════════════════════════
# SDN DDoS Detection Lab — Variables de Entorno
# ═══════════════════════════════════════════════════════════
# Copia este archivo como .env y ajusta los valores

# ─── Controller SDN ───────────────────────────────────────
SDN_CONTROLLER=controller
CONTROLLER_APP=infra/controller/dc_switch.py
NETWORK_CONFIG_FILE=infra/configs/network_config.yaml

# ─── Monitoring ───────────────────────────────────────────
GRAPHITE_SERVER=graphite
GRAPHITE_POLLTIME=30
INFLUXDB_HOST=influxdb
INFLUXDB_POLLTIME=30
PROMETHEUS_POLLTIME=30

# ─── Grafana ──────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# ─── Pipeline de Datos ────────────────────────────────────
DATA_DIR=./data
CAPTURE_INTERVAL=2
